            "judge": {
                "llm": "SONNET",
                "criteria": [
                    {
                        "name": "non_manipulabilite",
                        "rule": "Un indicateur retenu ne doit pas pouvoir être amélioré sans créer de valeur réelle. Le taux de transformation compté en nombre de devis se manipule en cessant de chiffrer les gros dossiers ; le même taux compté en euros, beaucoup moins. Un délai moyen se manipule en écartant les cas difficiles. Ce critère importe partout, mais il devient critique sur une sélection gelée douze mois : un indicateur devenu cible SERA optimisé, et personne ne le rejugera avant un an.",
                        "min_score": 0.75
                    },
                    {
                        "name": "actionnabilite",
                        "rule": "Chaque 'decision_attendue' doit désigner une action concrète que le dirigeant peut engager, sur un levier qu'il contrôle. Une décision qui consiste à « surveiller », « analyser » ou « suivre » n'est pas une décision. Un indicateur dont l'écart n'est pas corrigeable — parce qu'il tient à la nature de la prestation ou du client — ne doit pas être retenu.",
                        "min_score": 0.75
                    },
                    {
                        "name": "non_redondance",
                        "rule": "Deux indicateurs ne doivent pas mesurer la même chose sous deux habillages. Si deux croisements désignent la même modalité défavorable pour la même raison, un seul doit être retenu.",
                        "min_score": 0.7
                    },
                    {
                        "name": "qualite_motifs",
                        "rule": "Les motifs d'écartement énoncent ce que le sondage a montré, et non une impression. « Réfutée : l'écart va dans l'autre sens » est un motif ; « peu concluant » n'en est pas un.",
                        "min_score": 0.3
                    }
                ],
                "sample_rate": 0.2
            }
        }
