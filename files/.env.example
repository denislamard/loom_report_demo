# files/.env
# Copiez ce fichier en files/.env et renseignez vos clés.
# Ne jamais committer files/.env : il est couvert par .gitignore.
#
# Les noms de variables proviennent du champ `api_keyname` de chaque bloc `llm`
# dans files/settings.json. Renommer l'un oblige à renommer l'autre.

# Anthropic — rôles HAIKU (exploration) et SONNET (cadrage stratégique, juge)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# MiniMax — rôle M3_MAIN (orchestrateur)
# https://www.minimax.io puis API Keys
M3_API_KEY=votre-cle-ici
